# Squaricle Group – Apache settings (works on Cloudways)

Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Old WordPress addresses -> new pages (permanent redirects)
RewriteRule ^corporate-policy/?$ /group-policies.php [R=301,L]
RewriteRule ^site-notice/?$ /privacy-policy.php [R=301,L]
RewriteRule ^cookie-policy/?$ /cookie-policy.php [R=301,L]
RewriteRule ^our-team/?$ /our-team.php [R=301,L]
RewriteRule ^leadership-team/?$ /our-team.php#leadership [R=301,NE,L]
RewriteRule ^squaricle-group-values/?$ /our-values.php [R=301,L]
RewriteRule ^diversity-and-inclusion/?$ /diversity-and-inclusion.php [R=301,L]
RewriteRule ^people-policy/?$ /people-policy.php [R=301,L]
RewriteRule ^corporate-social-responsibility/?$ /corporate-social-responsibility.php [R=301,L]
RewriteRule ^careers-with-ted-learning-group/?$ /careers.php [R=301,L]
RewriteRule ^emerging-u/?$ /emerging-u.php [R=301,L]
RewriteRule ^ted-learning/?$ /ted-learning.php [R=301,L]
RewriteRule ^talk-to-the-squaricle-group/?$ /index.php#contact [R=301,NE,L]

# The first test build used .html addresses: send them to the matching .php page
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([a-z0-9-]+)\.html$ /$1.php [R=301,L]

# Folders that are only for the site's own code, data and saved form copies
RewriteRule ^(inc|config|data|storage)(/|$) - [F,L]

# Clean addresses: /careers works as well as /careers.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/?$ $1.php [L]
</IfModule>

# Basic security headers
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Caching
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType video/mp4 "access plus 1 month"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 week"
ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Compression
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
